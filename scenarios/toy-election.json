{
  "version": 1,
  "name": "toy-election-crash-restart",
  "steps": [
    {
      "op": "inject",
      "kind": "campaign",
      "target": "n1",
      "payload": {"value": "alpha"}
    },
    {"op": "run", "count": 30},
    {"op": "inject", "kind": "crash", "target": "n2"},
    {"op": "execute_next"},
    {"op": "inject", "kind": "restart", "target": "n2"},
    {"op": "execute_next"}
  ]
}
