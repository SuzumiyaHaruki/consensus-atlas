{
  "version": 1,
  "name": "etcdraft-election-blocked-by-partition-then-healed",
  "steps": [
    {"op": "inject", "kind": "start", "target": "n1"},
    {"op": "inject", "kind": "start", "target": "n2"},
    {"op": "inject", "kind": "start", "target": "n3"},
    {"op": "run", "count": 100},
    {"op": "partition", "groups": [["n1"], ["n2", "n3"]]},
    {"op": "inject", "kind": "campaign", "target": "n1"},
    {"op": "run", "count": 200},
    {"op": "heal"},
    {"op": "run", "count": 400},
    {
      "op": "inject",
      "kind": "propose",
      "target": "n1",
      "payload": {"value": "after-heal"}
    },
    {"op": "run", "count": 400}
  ]
}
