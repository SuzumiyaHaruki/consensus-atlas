{
  "version": 1,
  "name": "etcdraft-crash-after-visible-write-before-sync",
  "steps": [
    {"op": "inject", "kind": "start", "target": "n1"},
    {"op": "inject", "kind": "start", "target": "n2"},
    {"op": "inject", "kind": "start", "target": "n3"},
    {"op": "run", "count": 100},
    {"op": "inject", "kind": "campaign", "target": "n1"},
    {"op": "execute_match", "match": {"kind": "campaign", "target": "n1"}},
    {"op": "execute_match", "match": {"kind": "persist", "target": "n1"}},
    {"op": "inject", "kind": "crash", "target": "n1"},
    {"op": "execute_match", "match": {"kind": "crash", "target": "n1"}},
    {"op": "inject", "kind": "restart", "target": "n1"},
    {"op": "execute_match", "match": {"kind": "restart", "target": "n1"}},
    {"op": "run", "count": 100},
    {"op": "inject", "kind": "campaign", "target": "n1"},
    {"op": "run", "count": 400}
  ]
}
