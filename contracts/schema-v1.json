{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consensus-atlas.dev/schema/protocol-contract-v1.json",
  "title": "Consensus Atlas Protocol Knowledge Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "family", "protocol", "pss_id", "fault_model", "nodes", "initial_membership", "state_dimensions", "capabilities", "operations", "semantics", "evaluation"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "pss_id": {"type": "string", "minLength": 1},
    "fault_model": {"enum": ["cft", "bft-limited"]},
    "nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "initial_membership": {"$ref": "#/$defs/initial_membership"},
    "state_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "semantics": {"$ref": "#/$defs/semantics"},
    "evaluation": {"$ref": "#/$defs/evaluation"}
  },
  "$defs": {
    "requires": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "initial_membership": {
      "type": "object", "additionalProperties": false, "required": ["voters", "learners"],
      "properties": {
        "voters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "learners": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "witness_labels"],
      "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "witness_labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "operation": {
      "type": "object", "additionalProperties": false, "required": ["id", "event_kind", "description"],
      "properties": {"id": {"type": "string", "minLength": 1}, "event_kind": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "requires": {"$ref": "#/$defs/requires"}}
    },
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "trigger", "witness_label", "monitor"],
      "properties": {"id": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "trigger": {"type": "string"}, "witness_label": {"type": "string"}, "monitor": {"type": "string"}, "requires": {"$ref": "#/$defs/requires"}}
    },
    "ordering": {
      "type": "object", "additionalProperties": false, "required": ["id", "before", "after", "description", "witness_label", "monitor"],
      "properties": {"id": {"type": "string"}, "before": {"type": "string"}, "after": {"type": "string"}, "description": {"type": "string"}, "witness_label": {"type": "string"}, "monitor": {"type": "string"}, "requires": {"$ref": "#/$defs/requires"}}
    },
    "fault": {
      "type": "object", "additionalProperties": false, "required": ["id", "action", "description", "witness_label", "monitor"],
      "properties": {"id": {"type": "string"}, "action": {"type": "string"}, "description": {"type": "string"}, "witness_label": {"type": "string"}, "monitor": {"type": "string"}, "requires": {"$ref": "#/$defs/requires"}}
    },
    "boundary": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "witness_label", "monitor"],
      "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "witness_label": {"type": "string"}, "monitor": {"type": "string"}, "requires": {"$ref": "#/$defs/requires"}}
    },
    "invariant": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "activation_label", "monitor"],
      "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "activation_label": {"type": "string"}, "monitor": {"type": "string"}, "requires": {"$ref": "#/$defs/requires"}}
    },
    "semantics": {
      "type": "object", "additionalProperties": false, "required": ["transitions", "orderings", "faults", "boundaries", "invariants"],
      "properties": {
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
        "orderings": {"type": "array", "items": {"$ref": "#/$defs/ordering"}},
        "faults": {"type": "array", "items": {"$ref": "#/$defs/fault"}},
        "boundaries": {"type": "array", "items": {"$ref": "#/$defs/boundary"}},
        "invariants": {"type": "array", "items": {"$ref": "#/$defs/invariant"}}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false, "required": ["weights", "threshold"],
      "properties": {
        "weights": {
          "type": "object", "additionalProperties": false, "required": ["transition", "ordering", "fault", "boundary", "property"],
          "properties": {"transition": {"type": "number", "minimum": 0}, "ordering": {"type": "number", "minimum": 0}, "fault": {"type": "number", "minimum": 0}, "boundary": {"type": "number", "minimum": 0}, "property": {"type": "number", "minimum": 0}}
        },
        "threshold": {
          "type": "object", "additionalProperties": false, "required": ["score", "min_category"],
          "properties": {"score": {"type": "number", "minimum": 0, "maximum": 100}, "min_category": {"type": "number", "minimum": 0, "maximum": 1}}
        }
      }
    }
  }
}
