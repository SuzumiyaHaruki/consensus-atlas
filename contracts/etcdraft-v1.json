{
  "version": 1,
  "id": "etcdraft-protocol-contract-v1",
  "family": "raft",
  "protocol": "etcd-raft-v3.6",
  "pss_id": "raft-family-pss-v1",
  "fault_model": "cft",
  "nodes": ["n1", "n2", "n3"],
  "initial_membership": {"voters": ["n1", "n2", "n3"], "learners": []},
  "state_dimensions": [
    "node running relation",
    "role relation",
    "relative term order",
    "leader and vote relation",
    "durable log shape",
    "commit/durable/applied frontier relation",
    "snapshot frontier relation",
    "voter relation"
  ],
  "capabilities": [
    {"id": "explicit-campaign", "description": "Trigger an explicit deterministic election attempt.", "witness_labels": ["transition:follower->candidate"]},
    {"id": "message-release-control", "description": "Capture outbound messages before scheduler-controlled delivery.", "witness_labels": ["message:released", "message:delivered"]},
    {"id": "message-drop-duplicate-partition", "description": "Apply deterministic transport faults to captured messages.", "witness_labels": ["message:dropped", "message:duplicated", "network:partition", "network:heal"]},
    {"id": "visible-write-durable-sync", "description": "Separate visible storage writes from durable synchronization.", "witness_labels": ["host:persist", "host:sync"]},
    {"id": "power-loss-restart", "description": "Restart a node only from its synchronized durable image.", "witness_labels": ["fault:restart"]},
    {"id": "ready-crash-cutpoints", "description": "Crash while native host work is outstanding.", "witness_labels": ["fault:crash"]},
    {"id": "application-apply", "description": "Observe committed output crossing the application boundary.", "witness_labels": ["host:apply"]},
    {"id": "exact-ready-send-barriers", "description": "Represent all legal native Ready send/write overlaps.", "witness_labels": ["host:exact-ready-barrier"]},
    {"id": "natural-election-timeout-replay", "description": "Replay native randomized election timeout behavior exactly.", "witness_labels": ["timeout:natural-election"]}
  ],
  "operations": [
    {"id": "boot", "event_kind": "start", "description": "Start a node from declared stable state."},
    {"id": "campaign", "event_kind": "campaign", "description": "Start an explicit election.", "requires": ["explicit-campaign"]},
    {"id": "propose", "event_kind": "propose", "description": "Submit an application value."},
    {"id": "deliver", "event_kind": "message", "description": "Deliver one captured message.", "requires": ["message-release-control"]},
    {"id": "persist", "event_kind": "persist", "description": "Write native output to visible storage.", "requires": ["visible-write-durable-sync"]},
    {"id": "sync", "event_kind": "sync", "description": "Advance the durable storage frontier.", "requires": ["visible-write-durable-sync"]},
    {"id": "release", "event_kind": "emit", "description": "Release a captured message to the scheduler.", "requires": ["message-release-control"]},
    {"id": "apply", "event_kind": "apply", "description": "Apply committed output.", "requires": ["application-apply"]},
    {"id": "ack", "event_kind": "acknowledge", "description": "Acknowledge one native output batch."},
    {"id": "crash", "event_kind": "crash", "description": "Discard volatile node state.", "requires": ["ready-crash-cutpoints"]},
    {"id": "restart", "event_kind": "restart", "description": "Recover from the durable image.", "requires": ["power-loss-restart"]},
    {"id": "timeout", "event_kind": "timeout", "description": "Trigger a native election timeout.", "requires": ["natural-election-timeout-replay"]}
  ],
  "semantics": {
    "transitions": [
      {
        "id": "transition.campaign",
        "from": "follower",
        "to": "candidate",
        "trigger": "campaign",
        "witness_label": "transition:follower->candidate",
        "monitor": "trace-integrity",
        "requires": ["explicit-campaign"]
      },
      {
        "id": "transition.leader",
        "from": "candidate",
        "to": "leader",
        "trigger": "deliver",
        "witness_label": "transition:candidate->leader",
        "monitor": "agreement",
        "requires": ["explicit-campaign", "message-release-control"]
      },
      {
        "id": "transition.natural-timeout",
        "from": "follower",
        "to": "candidate",
        "trigger": "timeout",
        "witness_label": "timeout:natural-election",
        "monitor": "trace-integrity",
        "requires": ["natural-election-timeout-replay"]
      }
    ],
    "orderings": [
      {
        "id": "ordering.persist",
        "before": "persist",
        "after": "ack",
        "description": "A native output batch reaches visible storage before acknowledgement.",
        "witness_label": "host:persist",
        "monitor": "trace-integrity",
        "requires": ["visible-write-durable-sync"]
      },
      {
        "id": "ordering.sync",
        "before": "sync",
        "after": "ack",
        "description": "A native output batch crosses a durable sync boundary.",
        "witness_label": "host:sync",
        "monitor": "trace-integrity",
        "requires": ["visible-write-durable-sync"]
      },
      {
        "id": "ordering.release",
        "before": "sync",
        "after": "release",
        "description": "An outbound message is released only after its declared host barrier.",
        "witness_label": "message:released",
        "monitor": "trace-integrity",
        "requires": ["visible-write-durable-sync", "message-release-control"]
      },
      {
        "id": "ordering.exact-ready-barrier",
        "before": "persist",
        "after": "release",
        "description": "All legal native Ready send/write overlaps are represented.",
        "witness_label": "host:exact-ready-barrier",
        "monitor": "trace-integrity",
        "requires": ["exact-ready-send-barriers"]
      }
    ],
    "faults": [
      {
        "id": "fault.crash",
        "action": "crash",
        "description": "A running node crashes and loses volatile state.",
        "witness_label": "fault:crash",
        "monitor": "trace-integrity",
        "requires": ["ready-crash-cutpoints"]
      },
      {
        "id": "fault.restart",
        "action": "restart",
        "description": "A stopped node restarts from its durable image.",
        "witness_label": "fault:restart",
        "monitor": "trace-integrity",
        "requires": ["power-loss-restart"]
      }
    ],
    "boundaries": [
      {
        "id": "boundary.quorum",
        "description": "A minimal three-node quorum elects one leader.",
        "witness_label": "transition:candidate->leader",
        "monitor": "agreement",
        "requires": ["explicit-campaign", "message-release-control"]
      }
    ],
    "invariants": [
      {
        "id": "property.agreement-activated",
        "description": "At least one non-empty committed entry activates agreement.",
        "activation_label": "commit",
        "monitor": "agreement",
        "requires": ["message-release-control", "application-apply"]
      },
      {
        "id": "property.apply",
        "description": "Committed output reaches the application apply boundary.",
        "activation_label": "host:apply",
        "monitor": "trace-integrity",
        "requires": ["application-apply"]
      }
    ]
  },
  "evaluation": {
    "weights": {
      "transition": 0.25,
      "ordering": 0.25,
      "fault": 0.2,
      "boundary": 0.15,
      "property": 0.15
    },
    "threshold": {
      "score": 80,
      "min_category": 0.65
    }
  }
}
