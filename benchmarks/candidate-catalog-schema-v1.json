{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consensus-atlas.local/schemas/candidate-catalog-v1.json",
  "title": "ConsensusAtlas typed Candidate Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "candidates"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "protocol", "family", "provenance", "source_reference",
        "root_cause_group", "requirements"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "protocol": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "repository": {"type": "string", "minLength": 1}
          }
        },
        "source_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "url"],
          "properties": {
            "revision": {"type": "string", "minLength": 1},
            "url": {"type": "string", "minLength": 1}
          }
        },
        "root_cause_group": {"type": "string", "minLength": 1},
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controllable_inputs", "observable_events", "driver_capabilities",
            "trusted_monitors", "execution_outcomes", "profile_bounds"
          ],
          "properties": {
            "controllable_inputs": {"$ref": "#/$defs/strings"},
            "observable_events": {"$ref": "#/$defs/strings"},
            "driver_capabilities": {"$ref": "#/$defs/strings"},
            "trusted_monitors": {"$ref": "#/$defs/strings"},
            "execution_outcomes": {"$ref": "#/$defs/strings"},
            "profile_bounds": {"$ref": "#/$defs/strings"}
          }
        }
      }
    }
  }
}
