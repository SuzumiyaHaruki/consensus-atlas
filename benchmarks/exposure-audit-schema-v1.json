{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consensus-atlas.local/schemas/exposure-audit-v1.json",
  "title": "ConsensusAtlas redacted blind-exposure audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "benchmark_id", "benchmark_digest", "public_artifacts", "passed", "findings"],
  "properties": {
    "version": {"const": 1},
    "benchmark_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "benchmark_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "public_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "digest"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "passed": {"type": "boolean"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "artifact_index": {"type": "integer", "minimum": 1},
          "code": {"enum": ["blind-manifest-mismatch", "invalid-public-json", "private-string-exposed"]}
        }
      }
    }
  }
}
