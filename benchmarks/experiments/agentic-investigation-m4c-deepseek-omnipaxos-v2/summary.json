            "dossier/blind-spots/coarse-message-type-hints"
          ]
        },
        {
          "milestone_id": "n2-timeout",
          "kind": "temporal-fired",
          "rationale": "n2's natural periodic pulse advances after missed n1 traffic and can expire its election timeout.",
          "support_refs": [
            "dossier/control-semantics/natural-periodic-pulse",
