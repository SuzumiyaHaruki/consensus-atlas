    "candidate": {
      "id": "client-op-loss-recovery",
      "property_ref": "client-operation-continuity",
      "inspiration_ref": "message-loss-progress-coupling",
      "summary": "Hypothesis: dropping one inflight message from n1 to backup n2 before n2 has seen the appended value lets n2 elect itself after its periodic pulse; if leadership moves before the operation is durably replicated, the subsequent decision may lose or reorder the original request. The trace checks whether the request identity and value remain in the decided position.",
      "suspected_mechanism": "request-at-leader [workload-invoked]: Records the single client append entered at the configured coordinator n1 (priority 3). -\u003e n2-misses-leader-traffic [message-dropped]: One inflight message is dropped at n2, so the backup lacks the latest request context. -\u003e n2-timeout [temporal-fired]: n2's natural periodic pulse advances after missed n1 traffic and can expire its election timeout. -\u003e leadership-moves-to-n2 [coordinator-changed]: Leadership observation switches to n2 while the original operation is still unconfirmed. -\u003e decision-in-new-ballot [decision-advanced]: A decision is reported under the new ballot; compare its command identity with the request.",
      "mechanism_steps": [
        {
          "milestone_id": "request-at-leader",
          "kind": "workload-invoked",
          "rationale": "Records the single client append entered at the configured coordinator n1 (priority 3).",
          "support_refs": [
            "surface/workload",
            "dossier/active-experiment/worker-priority-config"
          ]
        },
        {
          "milestone_id": "n2-misses-leader-traffic",
          "kind": "message-dropped",
          "rationale": "One inflight message is dropped at n2, so the backup lacks the latest request context.",
          "support_refs": [
            "pattern/message-loss-progress-coupling",
