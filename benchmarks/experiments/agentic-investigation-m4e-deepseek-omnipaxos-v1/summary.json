          "support_refs": [
            "surface/observations",
            "dossier/components/runtime-owned-network"
          ]
        },
        {
          "milestone_id": "old-leader-reclaim",
          "kind": "temporal-fired",
          "rationale": "A pulse to n1 after the transition is the symmetric event that can make it reclaim leadership and prevent stable decision progress.",
          "support_refs": [
            "dossier/control-semantics/natural-periodic-pulse",
