{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consensus-atlas.local/schemas/sut-build-v1.json",
  "title": "ConsensusAtlas controlled SUT build input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "id", "trial_id", "module", "source", "package",
    "sut_build_identity", "command_allowlist", "output_path"
  ],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "original_digest", "match", "replacement", "transformed_digest"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "original_digest": {"$ref": "#/$defs/digest"},
        "match": {"type": "string", "minLength": 1},
        "replacement": {"type": "string", "minLength": 1},
        "transformed_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "package": {"type": "string", "minLength": 1},
    "identity_variable": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_/-]+(\\.[A-Za-z0-9_/-]+)+$"
    },
    "sut_build_identity": {"type": "string", "minLength": 1},
    "command_allowlist": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["go-build", "go-list-module"]}
    },
    "output_path": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
